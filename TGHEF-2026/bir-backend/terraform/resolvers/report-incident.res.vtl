## IncidentResult{incidentId, accepted}. incidentId echoes the idempotency key
## (inc:<sub>:<ts>) so the desk and the reporter share one stable id.
#if($ctx.error)
  $util.error($ctx.error.message, $ctx.error.type)
#end
{ "incidentId": $util.toJson($ctx.args.input.idempotencyKey), "accepted": true }
