## B3: recordAttendance — a volunteer marks a shift check-in / check-out.
## The app's idempotencyKey (att:<sub>:<shiftId>:<kind>) IS the sort key, so a
## re-drain of the same queued mutation upserts the same row (idempotent; the
## field-sim gate requires zero dupes across an offline batch + sync).
{
  "version": "2018-05-29",
  "operation": "PutItem",
  "key": {
    "pk": $util.dynamodb.toDynamoDBJson("ATT"),
    "sk": $util.dynamodb.toDynamoDBJson($ctx.args.input.idempotencyKey)
  },
  "attributeValues": {
    "shiftId": $util.dynamodb.toDynamoDBJson($ctx.args.input.shiftId),
    "kind": $util.dynamodb.toDynamoDBJson($ctx.args.input.kind),
    "ts": $util.dynamodb.toDynamoDBJson($ctx.args.input.ts),
    "sub": $util.dynamodb.toDynamoDBJson($util.defaultIfNull($ctx.identity.sub, "server")),
    "recordedAt": $util.dynamodb.toDynamoDBJson($util.time.nowEpochSeconds())
  }
}
