#end
#set($items = [])
#set($cursor = 0)
#foreach($it in $ctx.result.items)
  #set($row = { "id": $it.sk, "day": $it.day, "titleEn": $it.titleEn, "titleHi": $it.titleHi })
  #if(!$util.isNull($it.venue)) $util.qr($row.put("venue", $it.venue)) #end
