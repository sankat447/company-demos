{
  "name": "bir-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest",
    "test:e2e": "maestro test .maestro",
    "codegen": "graphql-codegen --config codegen.ts",
    "contract:check": "node scripts/contract-check.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform all",
    "publish:direct": "tsx scripts/publish-direct.ts",
    "postinstall": "node scripts/ensure-stack-outputs.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.66.0",
    "aws-amplify": "^6.14.0",
    "expo": "~53.0.9",
    "expo-brightness": "~13.1.4",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.4",
    "expo-font": "~13.3.1",
    "expo-linking": "~7.1.5",
    "expo-localization": "~16.1.5",
    "expo-router": "~5.0.7",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.8",
    "expo-sqlite": "~15.2.10",
    "expo-status-bar": "~2.2.3",
    "i18next": "^24.2.2",
    "react": "19.0.0",
    "react-i18next": "^15.4.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.0.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.20.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.5",
    "prettier": "^3.5.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
