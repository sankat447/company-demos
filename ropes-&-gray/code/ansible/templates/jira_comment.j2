{# ansible/templates/jira_comment.j2 #}
{# Posted to Jira ticket by post_change_verify role via REST API #}
════════════════════════════════════════════════════
 ANSIBLE PATCH RUN REPORT
════════════════════════════════════════════════════
Ticket    : {{ jira_ticket_id | default('N/A') }}
Host      : {{ inventory_hostname }}  ({{ ansible_host }})
Cloud     : {{ cloud_provider | upper }}
Risk level: {{ risk_level | default('Medium') }}
Started   : {{ pre_change_state.timestamp }}
Completed : {{ post_change_state.timestamp }}
Verdict   : {{ post_change_state.verdict }}
AAP Job   : {{ aap_job_url | default('N/A') }}

────────────────────────────────────────────────────
 PRE-CHANGE STATE
────────────────────────────────────────────────────
KBs installed before : {{ pre_change_state.kb_count }}
Last boot            : {{ pre_change_state.last_boot }}
Uptime (days)        : {{ pre_change_state.uptime_days }}
Pending reboot before: {{ pre_change_state.pending_reboot }}
AUM pending updates  : {{ pre_change_state.aum_pending }}
{% if pre_change_state.risk_flags %}
Pre-change risk flags:
{% for flag in pre_change_state.risk_flags %}
  [!] {{ flag }}
{% endfor %}
{% else %}
Pre-change risk flags: none
{% endif %}

────────────────────────────────────────────────────
 PATCH EXECUTION
────────────────────────────────────────────────────
Dry run mode  : {{ dry_run | default(false) }}
Updates applied: {{ newly_installed_kbs | length }}
{% if newly_installed_kbs %}
KBs installed this run:
{% for kb in newly_installed_kbs %}
  + {{ kb }}
{% endfor %}
{% else %}
  (no new updates applied)
{% endif %}
Reboot required: {{ patch_reboot_required | default('N/A') }}
Rebooted       : {{ reboot_result.rebooted | default(false) }}

────────────────────────────────────────────────────
 POST-CHANGE STATE
────────────────────────────────────────────────────
KBs installed after  : {{ post_change_state.installed_kbs_count }}
Net new KBs this run : {{ post_change_state.kb_diff_added | join(', ') | default('none') }}
Pending reboot after : {{ post_change_state.pending_reboot }}
{% if post_change_state.stopped_services %}
Stopped services     :
{% for svc in post_change_state.stopped_services %}
  [WARN] {{ svc }}
{% endfor %}
{% else %}
Critical services    : all running
{% endif %}

{% if post_change_state.risk_flags %}
────────────────────────────────────────────────────
 RISK FLAGS  [ACTION REQUIRED]
────────────────────────────────────────────────────
{% for flag in post_change_state.risk_flags %}
  [!] {{ flag }}
{% endfor %}
{% else %}
 No risk flags detected.
{% endif %}

────────────────────────────────────────────────────
 NEXT ACTION
────────────────────────────────────────────────────
{% if post_change_state.verdict == 'PASS' %}
Ticket transitioned to: Pending QA
QA engineer: please review this report and transition to Resolved if satisfied.
{% else %}
Verdict is FAIL. Rollback has been triggered automatically.
QA engineer: review rollback comment below and confirm state.
{% endif %}
════════════════════════════════════════════════════
