# aws_windows_target.tf
# Windows Server 2019 patch target on AWS.
# Used when Azure resource group permissions are not available.
# AAP connects via WinRM HTTPS (5986) from the same VPC as the AAP EC2.
#
# Architecture with this file:
#   AAP EC2 (RHEL9) ──WinRM HTTPS──► Windows EC2 (Server 2019)
#   Both in the same VPC (10.10.0.0/16), same public subnet
#   NSG allows WinRM only from the AAP security group (not public internet)

# ── Security group for Windows target ────────────────────────────────────────
resource "aws_security_group" "windows_target" {
  name        = "${local.prefix}-win-target-sg"
  description = "Windows patch target: WinRM from AAP, RDP from operator"
  vpc_id      = aws_vpc.aap.id

  # WinRM HTTPS - only from AAP security group (AAP is the only patcher)
  ingress {
    description     = "WinRM HTTPS from AAP"
    from_port       = 5986
    to_port         = 5986
    protocol        = "tcp"
    security_groups = [aws_security_group.aap.id]
  }

  # WinRM HTTPS - from operator IP for local ansible-playbook testing
  ingress {
    description = "WinRM HTTPS from operator"
    from_port   = 5986
    to_port     = 5986
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  # RDP - operator only for manual verification during demo
  ingress {
    description = "RDP from operator"
    from_port   = 3389
    to_port     = 3389
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  egress {
    description = "All outbound - Windows Update, WinRM responses"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(local.tags, { Name = "${local.prefix}-win-target-sg" })
}

# ── Windows Server 2019 AMI (latest, Amazon-owned) ───────────────────────────
data "aws_ami" "windows_2019" {
  most_recent = true
  owners      = ["801119661308"] # Amazon official Windows AMIs

  filter {
    name   = "name"
    values = ["Windows_Server-2019-English-Full-Base-*"]
  }
  filter {
    name   = "state"
    values = ["available"]
  }
}

# ── WinRM bootstrap userdata ──────────────────────────────────────────────────
# Runs on first boot via EC2 userdata (PowerShell).
# Creates a self-signed cert, enables WinRM HTTPS on 5986,
# opens Windows Firewall, sets the admin password.
locals {
  winrm_userdata = <<-WINDATA
    <powershell>
    # Configure WinRM HTTPS for Ansible
    winrm quickconfig -quiet
    winrm set winrm/config/service '@{AllowUnencrypted="false"}'
    winrm set winrm/config/service/auth '@{Basic="true"}'
    winrm set winrm/config/winrs '@{MaxMemoryPerShellMB="1024"}'

    # Create self-signed certificate and HTTPS listener
    $cert = New-SelfSignedCertificate `
      -DnsName $env:COMPUTERNAME `
      -CertStoreLocation Cert:\LocalMachine\My `
      -KeyAlgorithm RSA `
      -KeyLength 2048
    $thumb = $cert.Thumbprint

    # Remove any existing HTTPS listener then create fresh one
    Get-ChildItem WSMan:\LocalHost\Listener | `
      Where-Object { $_.Keys -like "*Transport=HTTPS*" } | `
      Remove-Item -Recurse -Force -ErrorAction SilentlyContinue

    New-Item -Path WSMan:\LocalHost\Listener `
      -Transport HTTPS `
      -Address * `
      -CertificateThumbPrint $thumb `
      -Force

    # Open firewall for WinRM HTTPS
    netsh advfirewall firewall add rule `
      name="WinRM HTTPS" `
      dir=in `
      localport=5986 `
      protocol=TCP `
      action=allow

    # Set local admin password to match Terraform variable
    $secpwd = ConvertTo-SecureString "${var.windows_admin_password}" -AsPlainText -Force
    Set-LocalUser -Name "${var.windows_admin_username}" -Password $secpwd

    # Restart WinRM to apply all changes
    Restart-Service winrm

    # Tag the instance via SSM (informational only)
    Write-EventLog -LogName Application `
      -Source "WinRM-Setup" `
      -EventId 1000 `
      -EntryType Information `
      -Message "WinRM HTTPS configured successfully on port 5986" `
      -ErrorAction SilentlyContinue

    Write-Output "WinRM setup complete"
    </powershell>
    <persist>true</persist>
  WINDATA
}

# ── Windows EC2 instance ──────────────────────────────────────────────────────
resource "aws_instance" "windows_target" {
  ami                    = data.aws_ami.windows_2019.id
  instance_type          = var.windows_vm_size_aws
  subnet_id              = aws_subnet.aap_public.id
  vpc_security_group_ids = [aws_security_group.windows_target.id]
  key_name               = aws_key_pair.aap.key_name
  user_data              = local.winrm_userdata

  # WinRM setup via userdata takes 5-8 minutes after first boot.
  # Do not run ansible until this completes.
  # Check: aws ec2 get-console-output --instance-id <id>

  root_block_device {
    volume_size           = 60
    volume_type           = "gp3"
    encrypted             = true
    delete_on_termination = true
  }

  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "required" # IMDSv2
  }

  tags = merge(local.tags, {
    Name         = "${local.prefix}-win-target"
    OS           = "Windows Server 2019"
    Role         = "patch-target"
    AAPTarget    = "true"
    PatchGroup   = "demo-security-updates"
  })
}

# ── Elastic IP for Windows target (stable IP for Ansible inventory) ───────────
resource "aws_eip" "windows_target" {
  instance = aws_instance.windows_target.id
  domain   = "vpc"
  tags     = merge(local.tags, { Name = "${local.prefix}-win-target-eip" })

  depends_on = [aws_internet_gateway.aap]
}
