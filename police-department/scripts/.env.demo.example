# =============================================================================
#   Police-Department demo · credentials & config
#   Copy this file to .env.demo and fill in your values.
#   .env.demo IS .gitignore'd — never commit it. (.env.demo.example IS committed)
# =============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Path to the cluster's kubeconfig (created by ai-demo-stack-aws Terraform).
# system:admin level — needed to scale MachineSets, drain nodes, patch secrets.
PD_KUBECONFIG="/Users/sanjeevkumar/GitHub/ai-demo-stack-aws/environments/demo/ocp-install-dir/ai-demo/auth/kubeconfig"

# AWS SSO profile — the human running the script must have an SSO session
# active under this profile (run `aws sso login --profile $PD_AWS_PROFILE`
# beforehand, or the script will prompt). Used ONCE at first bring-up to
# provision the long-lived IAM user `pd-demo-s3-rw`. Subsequent runs only
# need the SSO session if --rotate-keys is passed.
PD_AWS_PROFILE="rhoai-demo"
PD_AWS_REGION="us-east-1"

# Anthropic Claude API key. Used by:
#   - persona /chat (text-only) when pd-llm-mode=claude
#   - vlm-caption Tekton task when pd-vlm-mode=claude-multimodal (frames once at ingest)
# Get one from https://console.anthropic.com/. Starts with sk-ant-api03-...
PD_ANTHROPIC_API_KEY="sk-ant-api03-REPLACE_ME"

# HuggingFace token for one-time Qwen-VL model staging into S3. Required only
# on the first bring-up of a fresh data lake (or when the model is missing
# from s3://${PD_BUCKET}/models/police-department/qwen2.5-vl-7b/). Get from
# https://huggingface.co/settings/tokens (read-access scope is enough).
PD_HF_TOKEN="hf_REPLACE_ME"


# ── OPTIONAL (autodiscovered or provisioned by the script if blank) ─────────

# Aurora pgvector endpoint + password. If blank, the script copies them from
# the platform's `aurora-credentials` Secret in the `ai-demo` namespace.
# Provide explicit values only if you're using a different DB instance.
PD_AURORA_HOST=""
PD_AURORA_PASSWORD=""

# Long-lived IAM keys for the KServe storage-initializer (model download).
# If blank, the script assumes the platform Terraform has already produced
# them. Ask `pd-demo-s3-rw` is the runtime user; this `pd-kserve-s3-reader`
# is a separate read-only user for the model bucket. Leave blank to skip.
PD_KSERVE_S3_AKID=""
PD_KSERVE_S3_SECRET=""

# Portkey API key (the persona service routes via Portkey when
# pd-llm-mode=local for Llama). If blank, persona just calls Anthropic
# direct in claude mode — Portkey is a nice-to-have, not required.
PD_PORTKEY_API_KEY=""


# ── ADVANCED (rarely change these) ──────────────────────────────────────────

# S3 bucket. The platform Terraform provisions this; defaults match the
# ai-demo-stack-aws repo's data lake bucket.
PD_BUCKET="ai-demo-data-lake"

# Demo namespaces (don't change unless you know what you're doing — the
# manifests + ArgoCD apps reference these names).
PD_NS_CCTV="pd-cctv"
PD_NS_PERSONAS="pd-personas"

# Cluster MachineSet base name. The Terraform run generates this per
# cluster (e.g. ai-demo-lt9wz, ai-demo-zpvwj). Leave BLANK to let the
# provision script auto-detect it from the live MachineSets — recommended.
PD_MACHINESET_PREFIX=""


# ── REFERENCE / CONVENIENCE (also read by the operator pasting into UIs) ──
#
# These are NOT consumed by the script itself, but the operator often
# needs them for browser logins during demos. Documented here so a fresh
# clone of the repo lands with one obvious place to look.
#
# kubeadmin password: also at
#   $(cat .../ocp-install-dir/ai-demo/auth/kubeadmin-password)
PD_OCP_CONSOLE_URL="https://console-openshift-console.apps.ai-demo.iisdemolab.click"
PD_OCP_USERNAME="kubeadmin"
PD_OCP_PASSWORD=""

# ArgoCD initial admin (also retrievable via the secret in step 5 below):
#   oc -n openshift-gitops get secret openshift-gitops-cluster -o jsonpath='{.data.admin\.password}' | base64 -d
PD_ARGOCD_URL="https://openshift-gitops-server-openshift-gitops.apps.ai-demo.iisdemolab.click"
PD_ARGOCD_USERNAME="admin"
PD_ARGOCD_PASSWORD=""

# Other UI placeholders — fill in if/when you need them for the demo.
PD_KEYCLOAK_PASSWORD=""          # Keycloak admin (rhoai-sso ns)
PD_MINIO_ROOT_PASSWORD=""        # MinIO root (rhoai-minio ns; default minio123 if not rotated)
PD_VAULT_TOKEN=""                # HashiCorp Vault root token
PD_OPENWEBUI_ADMIN_PASSWORD=""   # Open WebUI admin (set on first visit)

# Demo-specific URLs (informational — the script doesn't dial these):
PD_DEMO_URL="https://pd-persona-pd-personas.apps.ai-demo.iisdemolab.click"
PD_PREDICTOR_URL="https://pd-qwen25-vl-7b-predictor-pd-cctv.apps.ai-demo.iisdemolab.click"
PD_RHOAI_DASHBOARD_URL="https://rhods-dashboard-redhat-ods-applications.apps.ai-demo.iisdemolab.click"
PD_CLOUDBEAVER_URL="https://cloudbeaver-rhoai-tools.apps.ai-demo.iisdemolab.click"
PD_MLFLOW_URL="https://mlflow-rhoai-mlflow.apps.ai-demo.iisdemolab.click"
PD_GRAFANA_URL="https://grafana-rhoai-monitoring.apps.ai-demo.iisdemolab.click"
