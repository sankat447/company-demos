# Copy to .env for local runs. In-cluster these come from Vault/SSM (L6/L7), NOT here.
# FOR DEMONSTRATION ONLY — SYNTHETIC DATA.

NYCHHC_MODE=echo

# --- LLM routing (L5) ---
NYCHHC_PORTKEY_BASE_URL=http://portkey.ai-demo.svc:8787
# NYCHHC_PORTKEY_VIRTUAL_KEY=   # live mode: injected from Vault
NYCHHC_PRIMARY_MODEL=llama-3-1-8b
NYCHHC_FALLBACK_MODEL=bedrock-claude-3-haiku

# --- data plane (live mode) ---
# NYCHHC_AURORA_DSN=            # from SSM /ai-demo/aurora/endpoint
# NYCHHC_MONGO_URI=
# NYCHHC_REDIS_URL=
# NYCHHC_MINIO_ENDPOINT_URL=

# --- predictive models (DR-06 / DR-08) ---
# NYCHHC_NOSHOW_MODEL_URL=
# NYCHHC_FORECAST_MODEL_URL=
NYCHHC_MODELS_FALLBACK_ENABLED=true

# --- telemetry (L9) ---
NYCHHC_OTEL_ENDPOINT=otel-collector.observability.svc:4317
NYCHHC_OTEL_ENABLED=false
